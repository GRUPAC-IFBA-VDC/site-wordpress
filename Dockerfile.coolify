FROM wordpress:php8.2-apache

# Keep the same Apache behavior used in local docker-compose.
COPY apache/wordpress.conf /etc/apache2/sites-available/000-default.conf

# Ship the tracked WordPress project inside the image.
COPY wordpress/ /var/www/html/

RUN set -eux; \
    a2enmod rewrite; \
    mkdir -p \
        /var/www/html/wp-content/uploads \
        /var/www/html/wp-content/cache \
        /var/www/html/wp-content/upgrade; \
    chown -R www-data:www-data /var/www/html; \
    { \
        echo 'upload_max_filesize=128M'; \
        echo 'post_max_size=128M'; \
        echo 'memory_limit=256M'; \
        echo 'max_execution_time=300'; \
    } > /usr/local/etc/php/conf.d/uploads.ini

EXPOSE 80
